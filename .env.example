# כתובת האתר המלאה ל-SEO (canonical, Open Graph, JSON-LD). ללא סלאש בסוף.
# דוגמה: https://www.etech.co.il
VITE_SITE_URL=https://www.example.com

# פרטי חיבור ל-Supabase (Project Settings -> API בדשבורד של Supabase).
# חובה להגדיר את שני המשתנים גם ב-Vercel (Production + Preview), אחרת
# הדשבורד ותעודות האחריות ייפלו חזרה ל-localStorage בלבד.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
